# 复制到本机环境变量或部署平台的 Secret 配置，不要提交真实值。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
SPRING_AI_MODEL_CHAT=deepseek

AMAP_BASE_URL=https://restapi.amap.com
AMAP_API_KEY=your-amap-web-service-key

QWEATHER_API_HOST=https://your-project-id.re.qweatherapi.com
QWEATHER_API_KEY=your-qweather-api-key

APP_AUTH_REDIS_ENABLED=true
APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6380
APP_REDIS_PASSWORD=your-local-redis-password
APP_REDIS_DATABASE=0
APP_REDIS_SSL=false
APP_REDIS_TIMEOUT=2s

# 邮箱验证码。授权码不是邮箱登录密码，需要先在网易邮箱中开启 SMTP 服务。
APP_EMAIL_MODE=smtp
APP_EMAIL_HOST=smtp.163.com
APP_EMAIL_PORT=465
APP_EMAIL_USERNAME=your-email@163.com
APP_EMAIL_PASSWORD=your-email-authorization-code
APP_EMAIL_FROM=your-email@163.com
APP_EMAIL_SSL_ENABLED=true
APP_EMAIL_STARTTLS_ENABLED=false
APP_EMAIL_CONNECT_TIMEOUT=10s
APP_EMAIL_READ_TIMEOUT=30s
APP_EMAIL_WRITE_TIMEOUT=30s

# 人机验证与接口限流。
APP_CAPTCHA_CHALLENGE_TTL=2m
APP_CAPTCHA_LOGIN_FAILURES=3
APP_CAPTCHA_FAILURE_WINDOW=10m
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_TRUST_FORWARDED=false
APP_RATE_LIMIT_GENERAL=120
APP_RATE_LIMIT_AUTH=60
APP_RATE_LIMIT_CAPTCHA=20

# 开发前端来源，多个用逗号分隔；生产环境替换成正式域名。
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
