# 复制到本机环境变量或部署平台的 Secret 配置，不要提交真实值。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
SPRING_AI_MODEL_CHAT=deepseek

# 实时对话：按顺序选择第一个可用模型，没有密钥时自动降级到 rule。
# 换模型只需要新增 ChatModelPort 实现并改这里，不需要改业务代码。
APP_CHAT_PROVIDERS=spring-ai,rule
APP_CHAT_CONTEXT_MESSAGES=20
APP_CHAT_STREAM_TIMEOUT=5m
# 仅规则降级模式的增量间隔，设为 0 可关闭（不影响真实大模型流式输出）。
APP_CHAT_RULE_CHUNK_DELAY=25ms

AMAP_BASE_URL=https://restapi.amap.com
AMAP_API_KEY=your-amap-web-service-key

QWEATHER_API_HOST=https://your-project-id.re.qweatherapi.com
QWEATHER_API_KEY=your-qweather-api-key

APP_AUTH_REDIS_ENABLED=true
APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6380
APP_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
APP_REDIS_DATABASE=0
APP_REDIS_SSL=false
APP_REDIS_TIMEOUT=2s

# 邮箱验证码。授权码不是邮箱登录密码，需要先在网易邮箱中开启 SMTP 服务。
APP_EMAIL_MODE=smtp
APP_EMAIL_HOST=smtp.163.com
APP_EMAIL_PORT=465
APP_EMAIL_USERNAME=CHANGE_ME_EMAIL_USERNAME
APP_EMAIL_PASSWORD=CHANGE_ME_EMAIL_AUTHORIZATION_CODE
APP_EMAIL_FROM=CHANGE_ME_EMAIL_FROM
APP_EMAIL_SSL_ENABLED=true
APP_EMAIL_STARTTLS_ENABLED=false
APP_EMAIL_CONNECT_TIMEOUT=10s
APP_EMAIL_READ_TIMEOUT=30s
APP_EMAIL_WRITE_TIMEOUT=30s

# local profile 演示账号。首次启动本地 H2 时会按这里的值创建账号。
APP_DEV_USER_PASSWORD=CHANGE_ME_DEV_USER_PASSWORD
APP_DEV_ADMIN_PASSWORD=CHANGE_ME_DEV_ADMIN_PASSWORD

# 人机验证与接口限流。
APP_CAPTCHA_CHALLENGE_TTL=2m
APP_CAPTCHA_LOGIN_FAILURES=1
APP_CAPTCHA_FAILURE_WINDOW=10m
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_TRUST_FORWARDED=false
APP_RATE_LIMIT_GENERAL=120
APP_RATE_LIMIT_AUTH=60
APP_RATE_LIMIT_CAPTCHA=20

# 开发前端来源，多个用逗号分隔；生产环境替换成正式域名。
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Docker Compose 一键启动。生产部署必须替换所有默认密码和 JWT 密钥。
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=travel
MYSQL_USER=travel
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_PORT=3307
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6381
APP_JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_SECRET
APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_NICKNAME=Docker 管理员
BACKEND_PORT=8080
FRONTEND_PORT=5174
