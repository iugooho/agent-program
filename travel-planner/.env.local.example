# 本地 H2 一键启动模板。复制为 .env.local 后替换所有 CHANGE_ME_* 占位符。
SPRING_PROFILES_ACTIVE=local
APP_JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_SECRET

# 本地演示默认使用内存验证码和会话撤销；需要联调本机 Redis 时改为 true。
APP_AUTH_REDIS_ENABLED=false
APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6380
APP_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# 本地开发将验证码写入 backend/target/local-email-outbox.log，不连接真实 SMTP。
APP_EMAIL_MODE=local

# 可选：默认保存到 backend/uploads/avatars。
APP_PROFILE_AVATAR_DIR=uploads/avatars

# 首次启动 local profile 时创建以下两个账号。
APP_DEV_USER_PASSWORD=CHANGE_ME_DEV_USER_PASSWORD
APP_DEV_ADMIN_PASSWORD=CHANGE_ME_DEV_ADMIN_PASSWORD
