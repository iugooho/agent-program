{
  "name": "travel-planner-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "travel-planner 项目（由 scaffold-cli 生成）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "gen:api": "node scripts/gen-api-types.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0",
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "@stomp/stompjs": "^7.1.0"
  },
  "devDependencies": {
    "vite": "^6.0.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vue-tsc": "^2.2.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "typescript-eslint": "^8.18.0",
    "prettier": "^3.4.2",
    "vitest": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0"
  }
}
